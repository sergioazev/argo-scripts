{
  "name": "argo-organizador-mac",
  "version": "1.3.0",
  "description": "Argo Organizador para macOS — estruturas de pastas, templates, preview, apply, rename e rollback.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --mac",
    "dist": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "tv.argonautas.argoorganizador",
    "productName": "Argo Organizador",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "author": "Argonautas"
}
